  },
  "dependencies": {},
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/lodash": "^4.17.24",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-typescript-paths": "^1.5.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.1"
  },
  "peerDependencies": {
    "vite": "^8.1.1"
  }
}
