{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "rootDir": "../",
    "paths": {
      "@/*": ["./src/*"],
      "shared/*": ["../shared/src/*"]
    }
  },
  "include": ["./src", "../shared/src"]
}
